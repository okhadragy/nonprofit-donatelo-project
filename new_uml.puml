@startuml 1-domain-model
' =====================================================
' 1. DOMAIN MODEL
' Columns: Beneficiary | Donor | Volunteer (+ Admin)
' Events sit at the bottom, under VolunteerAssignment.
' Rule of thumb: "--" = vertical link, "-" = horizontal link
' =====================================================
top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam package {
  BackgroundColor White
  BorderColor #64748b
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  ArrowColor #475569
}
hide empty members

package "Users" as Users {
  abstract class User {
    - id: Long
    - name: String
    - email: String
    - username: String
    - password: String
    - role: String
  }
  class Donor
  class Volunteer {
    - status: String
  }
  class Beneficiary {
    - city: String
    - status: String
  }
  class Admin

  User <|-- Donor
  User <|-- Volunteer
  User <|-- Beneficiary
  User <|-- Admin
}

package "Donations" as Donations {
  class Donation {
    - id: Long
    - amount: BigDecimal
    - date: Date
    - method: String
    + getDescription(): String
    + getCost(): double
  }
  class DonationType {
    - id: Long
    - name: String
  }

}

package "Volunteer Management" as VolunteerModel {
  class Qualification {
    - id: Long
    - name: String
    - description: String
  }
  class Role {
    - id: Long
    - name: String
    - description: String
  }
  class VolunteerAssignment {
    - id: Long
    - hoursWorked: double
  }
}

package "Beneficiary Resources" as Resources {
  class BeneficiaryCategory {
    - id: Long
    - name: String
  }
  class ResourceDistribution {
    - id: Long
    - quantity: int
    - distributionDate: Date
  }
  class Resource {
    - id: Long
    - name: String
    - description: String
  }
  class ResourceCategory {
    - id: Long
    - name: String
  }
}

package "Events" as Events {
  class EventCategory {
    - id: Long
    - name: String
  }
  class Event {
    - id: Long
    - title: String
    - date: Date
    - location: String
    - status: String
    + getDescription(): String
  }
  class Ticket {
    - id: Long
    - name: String
    - price: BigDecimal
  }
  class EventRegistration {
    - id: Long

    - attendanceStatus: String
  }
}

' ---- Donor column
Donor "1" -- "0..*" Donation : makes
Donation "0..*" -- "1" DonationType : classified by

' ---- Volunteer column
Volunteer "0..*" -- "0..*" Qualification : has
Volunteer "0..*" -- "0..*" Role : prefers
Volunteer "1" -- "0..*" VolunteerAssignment : receives
VolunteerAssignment "0..*" - "1" Role : assigned role
VolunteerAssignment "0..*" -- "1" Event : requires

' ---- Beneficiary column (lookup classes go OUTWARD / left)
Beneficiary "0..*" -- "1" BeneficiaryCategory : classified by
Beneficiary "1" -- "0..*" ResourceDistribution : receives
Resource "1" - "0..*" ResourceDistribution : distributed as
ResourceCategory "1" - "0..*" Resource : classifies

' ---- Events (lookup class goes OUTWARD / right)
Event "0..*" - "1" EventCategory : classified by
Event "1" -- "0..*" Ticket : offers

Ticket "1" - "0..*" EventRegistration : selected for

' ---- Layout hints: keep the user branches side by side
Beneficiary -[hidden]right- Donor
Donor -[hidden]right- Volunteer
Volunteer -[hidden]right- Admin
Qualification -[hidden]right- VolunteerAssignment
ResourceDistribution -[hidden]right- BeneficiaryCategory
@enduml


@startuml 2-design-patterns
' =====================================================
' 2. DESIGN PATTERNS
' Left to right: Donation Observer | Strategy | Document Factory
'                | Event Decorator | Event Observer
' Donation (top-left) and Event (top-right) are the anchors.
' =====================================================
top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55
skinparam package {
  BackgroundColor White
  BorderColor #64748b
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  ArrowColor #475569
}
hide empty members

' Entities from the domain model (collapsed)
class Donation
class Event

' ---------- STRATEGY PATTERN (Context) ----------
package "Strategy Pattern (Context)" as Strategy {
  class DonationStrategyContext {
    - strategies: Map<String, DonationStrategy>
    - strategy: DonationStrategy
    - strategyName: String
    + setStrategy(strategyName: String)
    + getStrategyName(): String
    + processDonation()
  }
  interface DonationStrategy {
    + getStrategyName(): String
    + processDonation()
  }
  class CashDonation
  class CardDonation
  class CheckDonation

  DonationStrategyContext o-down- "1" DonationStrategy : delegates to
  DonationStrategy <|.. CashDonation
  DonationStrategy <|.. CardDonation
  DonationStrategy <|.. CheckDonation
}

' ---------- DOCUMENT FACTORY (Factory Method + Singleton) ----------
package "Document Factory (Factory Method + Singleton)" as DocFactory {
  abstract class DocumentFactory {
    + {abstract} createDocument(donation: Donation): Document
  }
  class ReceiptDocumentFactory {
    - {static} INSTANCE: ReceiptDocumentFactory
    - ReceiptDocumentFactory()
    + {static} getInstance(): ReceiptDocumentFactory
    + createDocument(donation: Donation): Document
  }
  class TaxDocumentFactory {
    - {static} INSTANCE: TaxDocumentFactory
    - TaxDocumentFactory()
    + {static} getInstance(): TaxDocumentFactory
    + createDocument(donation: Donation): Document
  }
  interface Document {
    + generate(): String
  }
  class ReceiptDocument {
    + generate(): String
  }
  class TaxDocument {
    + generate(): String
  }

  DocumentFactory <|-- ReceiptDocumentFactory
  DocumentFactory <|-- TaxDocumentFactory
  ReceiptDocumentFactory .down.> ReceiptDocument : creates
  TaxDocumentFactory .down.> TaxDocument : creates
  Document <|.. ReceiptDocument
  Document <|.. TaxDocument
}

' ---------- DONATION OBSERVER ----------
package "Donation Observer" as DonationObserverPackage {
  interface Subject {
    + addObserver(observer: DonationObserver)
    + removeObserver(observer: DonationObserver)
    + notifyObservers()
  }
  class DonationSubject {
    - observers: List<DonationObserver>
    - message: String
    + addObserver(observer: DonationObserver)
    + removeObserver(observer: DonationObserver)
    + notifyObservers()
    + setMessage(message: String)
  }
  interface DonationObserver {
    + update(message: String)
  }
  class DonationEmailNotifier {
    + update(message: String)
  }
  class DonationSmsNotifier {
    + update(message: String)
  }
  class DonationInSiteNotifier {
    + update(message: String)
  }

  Subject <|.. DonationSubject
  DonationSubject o-down- "0..*" DonationObserver : notifies
  DonationObserver <|.. DonationEmailNotifier
  DonationObserver <|.. DonationSmsNotifier
  DonationObserver <|.. DonationInSiteNotifier
}

' ---------- EVENT OBSERVER ----------
package "Event Observer" as EventObserverPackage {
  class EventSubject {
    - observers: List
    + addObserver(observer: EventObserver)
    + removeObserver(observer: EventObserver)
    + notifyObservers()
  }
  interface EventObserver {
    + update(message: String)
  }
  class EventEmailNotifier {
    + update(message: String)
  }

  EventSubject o-down- "0..*" EventObserver : notifies
  EventObserver <|.. EventEmailNotifier
}

' ---------- DECORATOR ----------
package "Event Decorator" as Decorator {
  interface EventComponent {
    + getDescription(): String
  }
  abstract class EventDecorator {
    # event: EventComponent
    + EventDecorator(event: EventComponent)
    + getDescription(): String
  }
  class FundraisingDecorator
  class ReminderDecorator
  class FollowUpDecorator

  EventComponent <|.. EventDecorator
  EventDecorator o-left- EventComponent : wraps
  EventDecorator <|-- FundraisingDecorator
  EventDecorator <|-- ReminderDecorator
  EventDecorator <|-- FollowUpDecorator
}

' ---------- CROSS-PATTERN LINKS ----------
' Donation side (left): observer, strategy and document factories on one row
DonationSubject .up.> Donation : monitors
Donation .down.> DonationStrategyContext : uses
Donation .down.> DocumentFactory : uses for documents

' Event side (right): decorator, then observer on the same row
EventSubject .up.> Event : monitors
Event .down.|> EventComponent

' ---------- LAYOUT ----------
Donation -[hidden]right- Event
DonationSubject -[hidden]right- DonationStrategyContext
DonationStrategyContext -[hidden]right- DocumentFactory
DocumentFactory -[hidden]right- EventComponent
EventComponent -[hidden]right- EventSubject


@enduml


@startuml 3-layered-architecture
' =====================================================
' 3. LAYERED ARCHITECTURE
' Each feature reads left to right:
' Page -> Controller -> Service -> Repository
' =====================================================
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 70
skinparam package {
  BackgroundColor White
  BorderColor #64748b
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  ArrowColor #475569
}
hide empty members

' ---------- VIEW (React) ----------
package "MVC - View (React)" as Views {
  class ResourcePage {
    - config: Object
    - rows: Array
    + search()
    + add()
    + edit()
    + remove()
  }
  class DonationPage
  class EventPage
  class VolunteerPage
  class BeneficiaryPage
  class Dashboard

  ResourcePage <|-- DonationPage
  ResourcePage <|-- EventPage
  ResourcePage <|-- VolunteerPage
  ResourcePage <|-- BeneficiaryPage
}

' ---------- CONTROLLERS ----------
package "MVC - Controllers" as Controllers {
  class DonationController <<RestController>> {
    + getAll()
    + getById(id: Long)
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class DonationTypeController <<RestController>> {
    + getAll()
    + getById(id: Long)
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class EventController <<RestController>> {
    + getAll()
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class EventCategoryController <<RestController>> {
    + getAll()
    + getById(id: Long)
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class VolunteerController <<RestController>> {
    + getAll()
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class BeneficiaryController <<RestController>> {
    + getAll()
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class BeneficiaryCategoryController <<RestController>> {
    + getAll()
    + getById(id: Long)
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
  class ResourceController <<RestController>> {
    + getAll()
    + create()
    + distribute()
  }
  class ResourceCategoryController <<RestController>> {
    + getAll()
    + getById(id: Long)
    + create()
    + update(id: Long)
    + delete(id: Long)
  }
}

' ---------- SERVICES ----------
package "Services" as Services {
  class DonationService <<Service>> {
    + getAll(): List<Donation>
    + getById(id: Long): Donation
    + create(donation: Donation): Donation
    + update(id: Long, donation: Donation): Donation
    + delete(id: Long)
    + processDonation(amount: double, method: String): boolean
  }
  class DonationTypeService <<Service>> {
    + getAll(): List<DonationType>
    + getById(id: Long): DonationType
    + create(donationType: DonationType): DonationType
    + update(id: Long, donationType: DonationType): DonationType
    + delete(id: Long)
  }
  class EventService <<Service>> {
    + getAll(): List<Event>
    + create(event: Event): Event
    + update(id: Long, event: Event): Event
    + delete(id: Long)
  }
  class EventCategoryService <<Service>> {
    + getAll(): List<EventCategory>
    + getById(id: Long): EventCategory
    + create(category: EventCategory): EventCategory
    + update(id: Long, category: EventCategory): EventCategory
    + delete(id: Long)
  }
  class VolunteerService <<Service>> {
    + getAll(): List<Volunteer>
    + create(volunteer: Volunteer): Volunteer
    + update(id: Long, volunteer: Volunteer): Volunteer
    + delete(id: Long)
  }
  class BeneficiaryService <<Service>> {
    + getAll(): List<Beneficiary>
    + create(beneficiary: Beneficiary): Beneficiary
    + update(id: Long, beneficiary: Beneficiary): Beneficiary
    + delete(id: Long)
  }
  class BeneficiaryCategoryService <<Service>> {
    + getAll(): List<BeneficiaryCategory>
    + getById(id: Long): BeneficiaryCategory
    + create(category: BeneficiaryCategory): BeneficiaryCategory
    + update(id: Long, category: BeneficiaryCategory): BeneficiaryCategory
    + delete(id: Long)
  }
  class ResourceService <<Service>> {
    + getAll(): List<Resource>
    + create(resource: Resource): Resource
    + distribute(resourceId: Long, beneficiaryId: Long)
  }
  class ResourceCategoryService <<Service>> {
    + getAll(): List<ResourceCategory>
    + getById(id: Long): ResourceCategory
    + create(category: ResourceCategory): ResourceCategory
    + update(id: Long, category: ResourceCategory): ResourceCategory
    + delete(id: Long)
  }
}

' ---------- REPOSITORIES ----------
package "Repositories (Spring Data JPA)" as Repositories {
  interface DonationRepository {
    + findAll(): List<Donation>
    + findById(id: Long): Optional<Donation>
    + save(donation: Donation): Donation
    + deleteById(id: Long)
  }
  interface DonationTypeRepository {
    + findAll(): List<DonationType>
    + findById(id: Long): Optional<DonationType>
    + existsByNameIgnoreCase(name: String): boolean
    + save(donationType: DonationType): DonationType
    + deleteById(id: Long)
  }
  interface EventRepository {
    + findAll(): List<Event>
    + findById(id: Long): Optional<Event>
    + save(event: Event): Event
    + deleteById(id: Long)
  }
  interface EventCategoryRepository {
    + findAll(): List<EventCategory>
    + findById(id: Long): Optional<EventCategory>
    + save(category: EventCategory): EventCategory
    + deleteById(id: Long)
  }
  interface VolunteerRepository {
    + findAll(): List<Volunteer>
    + findById(id: Long): Optional<Volunteer>
    + save(volunteer: Volunteer): Volunteer
  }
  interface BeneficiaryRepository {
    + findAll(): List<Beneficiary>
    + findById(id: Long): Optional<Beneficiary>
    + save(beneficiary: Beneficiary): Beneficiary
  }
  interface BeneficiaryCategoryRepository {
    + findAll(): List<BeneficiaryCategory>
    + findById(id: Long): Optional<BeneficiaryCategory>
    + save(category: BeneficiaryCategory): BeneficiaryCategory
    + deleteById(id: Long)
  }
  interface ResourceRepository {
    + findAll(): List<Resource>
    + findById(id: Long): Optional<Resource>
    + save(resource: Resource): Resource
  }
  interface ResourceCategoryRepository {
    + findAll(): List<ResourceCategory>
    + findById(id: Long): Optional<ResourceCategory>
    + save(category: ResourceCategory): ResourceCategory
    + deleteById(id: Long)
  }
  interface UserRepository {
    + findByUsername(username: String): Optional<User>
    + existsByUsername(username: String): boolean
    + save(user: User): User
  }
}



' ---------- PATTERN COLLABORATORS (collapsed, see diagram 2) ----------
package "Patterns used by services" as PatternStubs {
  class DonationStrategyContext
  interface DonationStrategy
  abstract class DocumentFactory
  class ReceiptDocumentFactory
  class TaxDocumentFactory
  interface Subject
  class DonationSubject
  class EventSubject
  interface EventComponent
}

' ---------- ONE CLEAN CHAIN PER FEATURE ----------
DonationPage ..> DonationController
DonationController ..> DonationService
DonationService ..> DonationRepository
DonationTypeController ..> DonationTypeService
DonationTypeService ..> DonationTypeRepository
DonationService ..> DonationTypeRepository

EventPage ..> EventController
EventController ..> EventService
EventService ..> EventRepository
EventCategoryController ..> EventCategoryService
EventCategoryService ..> EventCategoryRepository

VolunteerPage ..> VolunteerController
VolunteerController ..> VolunteerService
VolunteerService ..> VolunteerRepository

BeneficiaryPage ..> BeneficiaryController
BeneficiaryController ..> BeneficiaryService
BeneficiaryService ..> BeneficiaryRepository
BeneficiaryCategoryController ..> BeneficiaryCategoryService
BeneficiaryCategoryService ..> BeneficiaryCategoryRepository

ResourceController ..> ResourceService
ResourceService ..> ResourceRepository
ResourceCategoryController ..> ResourceCategoryService
ResourceCategoryService ..> ResourceCategoryRepository

' ---------- SERVICE -> PATTERN DEPENDENCIES ----------
DonationService ..> DonationStrategyContext : executes strategy
DonationService ..> DonationStrategy : processes donation
DonationService ..> DocumentFactory : creates documents
DonationService ..> ReceiptDocumentFactory : obtains instance
DonationService ..> TaxDocumentFactory : obtains instance
DonationService ..> DonationSubject : notifies observers
EventService ..> EventSubject : notifies observers
EventService ..> EventComponent : decorates events

' ---------- LAYOUT HINTS ----------
Dashboard -[hidden]down- DonationPage

' keep every column in the same feature order (in left-to-right mode, hidden "left" stacks top to bottom)
DonationController -[hidden]left- DonationTypeController
DonationTypeController -[hidden]left- EventController
EventController -[hidden]left- EventCategoryController
EventCategoryController -[hidden]left- VolunteerController
VolunteerController -[hidden]left- BeneficiaryController
BeneficiaryController -[hidden]left- BeneficiaryCategoryController
BeneficiaryCategoryController -[hidden]left- ResourceController
ResourceController -[hidden]left- ResourceCategoryController

DonationService -[hidden]left- DonationTypeService
DonationTypeService -[hidden]left- EventService
EventService -[hidden]left- EventCategoryService
EventCategoryService -[hidden]left- VolunteerService
VolunteerService -[hidden]left- BeneficiaryService
BeneficiaryService -[hidden]left- BeneficiaryCategoryService
BeneficiaryCategoryService -[hidden]left- ResourceService
ResourceService -[hidden]left- ResourceCategoryService

DonationRepository -[hidden]left- DonationTypeRepository
DonationTypeRepository -[hidden]left- EventRepository
EventRepository -[hidden]left- EventCategoryRepository
EventCategoryRepository -[hidden]left- VolunteerRepository
VolunteerRepository -[hidden]left- BeneficiaryRepository
BeneficiaryRepository -[hidden]left- BeneficiaryCategoryRepository
BeneficiaryCategoryRepository -[hidden]left- ResourceRepository
ResourceRepository -[hidden]left- ResourceCategoryRepository
ResourceCategoryRepository -[hidden]left- UserRepository
UserRepository -[hidden]left- RepoNote
@enduml
